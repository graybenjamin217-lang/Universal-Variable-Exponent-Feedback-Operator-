import os
import numpy as np
import matplotlib.pyplot as plt

# Ensure output directory exists
os.makedirs("figures", exist_ok=True)

# 1. Define Parameter Grid Boundaries
grid_size = 60
amplitudes = np.linspace(0.1, 2.0, grid_size)  # Exponent Modulation Amplitude (A)
gains = np.linspace(0.01, 0.20, grid_size)      # Coupling Gain (K)

# Create 2D Meshgrid for simultaneous array processing
A_grid, K_grid = np.meshgrid(amplitudes, gains)

# 2. Vectorized State Matrix Initialization (60x60 simultaneously)
Y = np.full((grid_size, grid_size), 0.5)
state_energy = np.zeros((grid_size, grid_size))
N = 250  # Simulation steps

# 3. Fast Vectorized Simulation Engine
for n in range(1, N):
    alpha = 1.0 + A_grid * np.sin(0.05 * n)
    dy = K_grid * (np.sin(Y) * (np.abs(Y) ** (alpha - 1.0)))
    Y = Y + dy
    state_energy += Y**2

heatmap_matrix = np.log10((state_energy / N) + 1e-12)

# 4. Render and Force Inline Plot Display
plt.figure(figsize=(8, 6.5))
im = plt.imshow(
    heatmap_matrix,
    extent=[amplitudes[0], amplitudes[-1], gains[0], gains[-1]],
    origin='lower',
    aspect='auto',
    cmap='magma'
)

cbar = plt.colorbar(im)
cbar.set_label(r'Log State Variance $\log_{10}(\langle y^2 \rangle)$', fontsize=11)

plt.title("Figure 3: Parameter Sensitivity Heatmap", fontsize=12, fontweight='bold')
plt.xlabel("Exponent Amplitude ($A$)", fontsize=11)
plt.ylabel("Feedback Gain ($K$)", fontsize=11)
plt.grid(False)
plt.tight_layout()

# Save PNG and render to screen
plt.savefig("figures/fig3_parameter_heatmap.png", dpi=300)
plt.show()

print("Status: Figure 3 generated instantly and saved to 'figures/fig3_parameter_heatmap.png'")
